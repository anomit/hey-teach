# NVIDIA NIM (OpenAI-compatible) — required only for --model nim
NVIDIA_API_KEY=

# Catalog model id served at integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-8b-instruct

# Abort hung chat requests (milliseconds). Default 60000.
# NIM_TIMEOUT_MS=60000

# Gap after each NIM chat call before the next (tool rounds). Default 2000.
# NIM_PACE_MS=2000

# Extra tries after a 429/5xx/connection drop. Default 3 (4 attempts total).
# NIM_MAX_RETRIES=3
